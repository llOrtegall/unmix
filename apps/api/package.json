{
  "name": "@unmix/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=../../.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint:deps && pnpm test",
    "db:generate": "drizzle-kit generate",
    "e2e": "node --env-file=../../.env test/e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@fastify/cors": "11.3.1",
    "@unmix/contracts": "workspace:^",
    "archiver": "8.0.0",
    "better-auth": "1.7.14",
    "bullmq": "6.5.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "neverthrow": "8.2.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/archiver": "8.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
