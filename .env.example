# Postgres
POSTGRES_USER=unmix
POSTGRES_PASSWORD=unmix
POSTGRES_DB=unmix
DATABASE_URL=postgres://unmix:unmix@localhost:5432/unmix

# Redis
REDIS_URL=redis://localhost:6379

# S3 (SeaweedFS in dev; must match infra/seaweedfs/s3.json)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=unmix
S3_SECRET_KEY=unmix-secret
S3_BUCKET=unmix
# Host the browser uses for presigned URLs (defaults to S3_ENDPOINT)
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Worker
DEMUCS_MODEL=htdemucs_6s
DEMUCS_DEVICE=cpu
MAX_DURATION_SECONDS=600
MAX_UPLOAD_MB=200
# 0 = torch default (physical cores)
TORCH_THREADS=0
LOG_LEVEL=INFO

# Auth (ADR 0009, 0025)
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Cloud OAuth client (web app); redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin that proxies /api/auth to the API (defaults to WEB_ORIGIN)
# BETTER_AUTH_URL=http://localhost:5173
