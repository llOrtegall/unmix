# Postgres
POSTGRES_USER=unmix
POSTGRES_PASSWORD=unmix
POSTGRES_DB=unmix
DATABASE_URL=postgres://unmix:unmix@localhost:5432/unmix

# Redis
REDIS_URL=redis://localhost:6379

# S3 (SeaweedFS in dev; must match infra/seaweedfs/s3.json)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=unmix
S3_SECRET_KEY=unmix-secret
S3_BUCKET=unmix

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Worker
DEMUCS_MODEL=htdemucs_6s
DEMUCS_DEVICE=cpu
MAX_DURATION_SECONDS=600
MAX_UPLOAD_MB=200
# 0 = torch default (physical cores)
TORCH_THREADS=0
LOG_LEVEL=INFO

# Auth (fase 5)
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
